# ── AI-udbyder ───────────────────────────────────────────────────────────────
# Vælg "base44" (online, kræver nøgle) eller "ollama" (lokal & gratis)
AI_PROVIDER=base44

# ── Base44 (kun nødvendigt hvis AI_PROVIDER=base44) ──────────────────────────
BASE44_API_KEY=din_base44_api_nøgle_her
BASE44_APP_ID=dit_app_id_her

# ── Ollama / Mistral (kun nødvendigt hvis AI_PROVIDER=ollama) ─────────────────
# Kør først: ollama serve  og  ollama pull mistral
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── InstantID authentication ─────────────────────────────────────────────────
# Base URL for the InstantID service used to authenticate MIA users
INSTANTID_BASE_URL=https://instantid.info

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
